# Don't let ripgrep vomit really long lines to my terminal.
--max-columns=500
--max-columns-preview

# Add my 'web' type.
--type-add
web:*.{html,css,js}*

# Because who cares about case!?
--smart-case

# We almost never want to ignore "hidden" files
#-u

--colors=match:none
--colors=match:fg:0xd9,0x77,0x57
--colors=match:style:bold
--colors=path:none
--colors=path:fg:0x7b,0x9e,0xbd
--colors=path:style:nobold
--colors=line:none
--colors=line:fg:0x93,0x8e,0x87
--colors=line:style:nobold
--colors=column:none
--colors=column:fg:0x5a,0x59,0x55
--colors=column:style:nobold
