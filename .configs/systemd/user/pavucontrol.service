[Unit]
Description=pavucontrol-qt
PartOf=graphical-session.target
After=graphical-session.target dbus.service


[Service]
Type=exec
# Private writable config home (~/.config is read-only); real config still read via XDG_CONFIG_DIRS
Environment=XDG_CONFIG_HOME=%h/.config/pavucontrol-qt XDG_CONFIG_DIRS=%h/.config:/etc/xdg
ExecStart=/usr/bin/pavucontrol-qt
Restart=no
Slice=app-graphical.slice
# Extra Hardening (Safe for GUI apps)
SystemCallArchitectures=native
ProtectClock=yes
ProtectKernelLogs=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
# Hardening settings for file system access
NoNewPrivileges=yes
ProtectSystem=full
PrivateTmp=yes
PrivateUsers=yes
LockPersonality=yes
ProtectHome=read-only
# libpulse needs its runtime dir; pavucontrol-qt saves its settings (see XDG_CONFIG_HOME)
ReadWritePaths=%t/pulse %h/.config/pavucontrol-qt
# Hardening settings for internal system info and namespaces
ProtectHostname=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectProc=invisible
# Network access (adjust as needed)
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
# System call filtering (adjust for your application)
#SystemCallFilter=~@chown @mount @pkey
#SystemCallFilter=~@clock @keyring @obsolete @privileged @raw-io @reboot @setuid @swap
# Hardening setting for kernel capabilities
# This is the most secure setting for a user service
# CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_CHOWN CAP_DAC_OVERRIDE CAP_SETGID CAP_SETUID
CapabilityBoundingSet=

[Install]
WantedBy=graphical-session.target
