[Unit]
Description=RIFT Intel Fusion Tool
PartOf=graphical-session.target
After=graphical-session.target dbus.service

[Service]
Type=exec
KillMode=mixed
# Native Wayland build from ~/opt/rift-6.2.0-source (JetBrains Runtime WLToolkit + a Compose
# Swing-rendering shim). Rebuild there with: mise exec -- ./gradlew createDistributable
# Fallback: the packaged /usr/bin/rift (XWayland) still works, but then add
# UnsetEnvironment=WAYLAND_DISPLAY to dodge its per-monitor scaling bug.
# ~/opt/rift is a symlink to the source clone and is the path pwrap mounts into its sandbox; the
# command must be named "rift" for pwrap to recognise it (./rift -> run-rift-wayland.sh).
ExecStart=/home/adam/.local/bin/pwrap /home/adam/opt/rift/rift
Restart=no
Slice=app-graphical.slice

[Install]
WantedBy=graphical-session.target
