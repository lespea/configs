[Unit]
Description=Slack
PartOf=graphical-session.target
After=graphical-session.target dbus.service


[Service]
Type=exec
KillMode=mixed
Environment="TMPDIR=%h/.config/Slack/.tmp"
ExecStart=/home/adam/.local/bin/pwrap /usr/bin/slack --password-store=gnome-libsecret --enable-features=UseOzonePlatform --ozone-platform=wayland -s
Restart=no
Slice=app-graphical.slice
# Sandboxing & isolation handled entirely by pwrap
# (systemd procfs/capability restrictions conflict with unprivileged user namespace /proc mounting)
#SystemCallArchitectures=native
#ProtectClock=yes
#ProtectKernelLogs=yes
#RestrictRealtime=yes
#RestrictSUIDSGID=yes
#NoNewPrivileges=yes
#ProtectSystem=full
#PrivateTmp=yes
#PrivateUsers=yes
#LockPersonality=yes
#ProtectHome=read-only
#ProtectHostname=yes
#ProtectKernelTunables=yes
#ProtectKernelModules=yes
#ProtectControlGroups=yes
#ProtectProc=invisible
#PrivateNetwork=no
#CapabilityBoundingSet=

[Install]
WantedBy=graphical-session.target
