# Don't let ripgrep vomit really long lines to my terminal.
--max-columns=500
--max-columns-preview

# Add my 'web' type.
--type-add
web:*.{html,css,js}*

# Because who cares about case!?
--smart-case

# We almost never want to ignore "hidden" files
#-u

--colors=match:none
--colors=match:fg:0xe8,0x9a,0x49
--colors=match:style:bold
--colors=path:none
--colors=path:fg:0x7c,0xc1,0xdc
--colors=path:style:nobold
--colors=line:none
--colors=line:fg:0xa6,0x9c,0x91
--colors=line:style:nobold
--colors=column:none
--colors=column:fg:0x91,0x88,0x7d
--colors=column:style:nobold
