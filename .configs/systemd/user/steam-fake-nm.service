[Unit]
Description=Fake NetworkManager for Steam (skips "Waiting for network")
Documentation=https://github.com/ValveSoftware/steam-for-linux/issues/9966
# Lives and dies with Steam; steam.service pulls this in via Wants=.
PartOf=steam.service
StopWhenUnneeded=yes
# Requires the D-Bus policy from ~/devel/fake-nm (`just install-policy`)
ConditionPathExists=/etc/dbus-1/system.d/steam-fake-nm.conf

[Service]
Type=notify
# Runs straight out of the build directory; rebuild with `just build` in ~/devel/fake-nm
ExecStart=%h/devel/fake-nm/target/release/fake-nm
Restart=no
Slice=app-graphical.slice
